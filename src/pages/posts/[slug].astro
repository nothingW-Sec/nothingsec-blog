---
import BaseLayout from "../../layouts/BaseLayout.astro";import Sidebar from "../../components/Sidebar.astro";import ReadingTools from "../../components/ReadingTools.astro";import {render} from "astro:content";import {getPosts,formatDate,readingTime,coverClass} from "../../lib/posts";
export async function getStaticPaths(){return (await getPosts()).map(post=>({params:{slug:post.id},props:{post}}))}const {post}=Astro.props;const {Content,headings}=await render(post);const d=post.data;
---
<BaseLayout title={`${d.title}｜边界之外`} description={d.description}><main><section class={`article-hero cover-${coverClass(d.category)}`}><div class="article-hero-content"><h1>{d.title}</h1><div><span>📅 {formatDate(d.publishDate)}</span><span>♻ 更新于 {formatDate(d.updatedDate??d.publishDate)}</span><a href={`/categories/${encodeURIComponent(d.category)}/`}>📁 {d.category}</a><span>☕ {readingTime(post.body??"")} 分钟</span></div></div></section><div class="content-shell article-layout"><article class="article-card"><div class="prose"><Content/></div><div class="article-tags">{d.tags.map((t:string)=><a href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>)}</div><div class="article-end"><b>安全声明</b><p>所有技术实践仅面向明确授权的靶场与实验环境。</p></div></article><Sidebar headings={headings}/></div><ReadingTools/></main></BaseLayout>
