---
import BaseLayout from "../../layouts/BaseLayout.astro";import Sidebar from "../../components/Sidebar.astro";import ReadingTools from "../../components/ReadingTools.astro";import {getImage} from "astro:assets";import {render} from "astro:content";import {getPosts,formatDate,readingTime,coverClass,postSlug,postUrl} from "../../lib/posts";
export async function getStaticPaths(){return (await getPosts()).map(post=>({params:{slug:postSlug(post.id)},props:{post}}))}const {post}=Astro.props;const {Content,headings}=await render(post);const d=post.data;const coverImage=d.cover?await getImage({src:d.cover,width:1600}):undefined;const seriesPosts=d.series?(await getPosts()).filter(item=>item.data.series===d.series).sort((a,b)=>{const aOrder=a.data.seriesOrder;const bOrder=b.data.seriesOrder;if(aOrder!==undefined&&bOrder!==undefined)return aOrder-bOrder||b.data.publishDate.valueOf()-a.data.publishDate.valueOf();if(aOrder!==undefined)return -1;if(bOrder!==undefined)return 1;return b.data.publishDate.valueOf()-a.data.publishDate.valueOf()}):[];const seriesIndex=seriesPosts.findIndex(item=>item.id===post.id);const previousInSeries=seriesIndex>0?seriesPosts[seriesIndex-1]:undefined;const nextInSeries=seriesIndex>=0&&seriesIndex<seriesPosts.length-1?seriesPosts[seriesIndex+1]:undefined;
---
<BaseLayout title={`${d.title}｜边界之外`} description={d.description} image={coverImage?.src}><main><section class={`article-hero cover-${coverClass(d.category)}`}>{coverImage&&<img class="article-hero-cover" src={coverImage.src} width={coverImage.attributes.width} height={coverImage.attributes.height} alt={d.coverAlt??""} loading="eager" decoding="async"/>}<div class="article-hero-content"><h1 data-pagefind-meta="title">{d.title}</h1><div><span>📅 {formatDate(d.publishDate)}</span>{d.updatedDate&&<span>♻ 更新于 {formatDate(d.updatedDate)}</span>}<a href={`/categories/${encodeURIComponent(d.category)}/`}>📁 {d.category}</a>{d.type&&<span>📄 {d.type}</span>}{d.difficulty&&<span>◈ {d.difficulty}</span>}{d.platform&&<span>⌘ {d.platform}</span>}{d.lastReviewed&&<span>最近复核 {d.lastReviewed.toISOString().slice(0,10)}</span>}<span>☕ {readingTime(post.body??"")} 分钟</span></div></div></section><div class="content-shell article-layout"><article class="article-card" data-pagefind-body><div class="search-index-meta" aria-hidden="true"><span>{d.description}</span><span data-pagefind-meta="category">{d.category}</span>{d.type&&<span data-pagefind-meta="type">{d.type}</span>}{d.series&&<span data-pagefind-meta="series">{d.series}</span>}<span data-pagefind-meta="tags">{d.tags.join(" · ")}</span></div><div class="prose"><Content/></div><div class="article-tags">{d.tags.map((t:string)=><a href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>)}</div>{d.series&&<nav class="series-nav" aria-label={`${d.series} 系列导航`}><p>所属系列：<strong>{d.series}</strong><a class="series-all" href={`/series/${encodeURIComponent(d.series)}/`}>查看完整系列 →</a></p>{(previousInSeries||nextInSeries)&&<div>{previousInSeries?<a class="series-previous" href={postUrl(previousInSeries.id)}><span>上一篇</span><b>{previousInSeries.data.title}</b></a>:<span></span>}{nextInSeries&&<a class="series-next" href={postUrl(nextInSeries.id)}><span>下一篇</span><b>{nextInSeries.data.title}</b></a>}</div>}</nav>}<div class="article-end"><b>安全声明</b><p>所有技术实践仅面向明确授权的靶场与实验环境。</p></div></article><Sidebar headings={headings}/></div><ReadingTools/></main></BaseLayout>
