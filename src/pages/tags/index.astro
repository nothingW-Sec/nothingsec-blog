---
import BaseLayout from "../../layouts/BaseLayout.astro";import {getPosts} from "../../lib/posts";const posts=await getPosts();const tags=[...new Set(posts.flatMap(p=>p.data.tags))];
---
<BaseLayout title="全部标签｜边界突破"><main class="listing-page"><p class="eyebrow">INDEX</p><h1>全部标签</h1><div class="tag-cloud">{tags.map(t=><a href={`/tags/${encodeURIComponent(t)}/`}>#{t}<span>{posts.filter(p=>p.data.tags.includes(t)).length}</span></a>)}</div></main></BaseLayout>
