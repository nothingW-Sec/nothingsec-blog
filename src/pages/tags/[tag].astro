---
import BaseLayout from "../../layouts/BaseLayout.astro";import PostCard from "../../components/PostCard.astro";import {getPosts} from "../../lib/posts";export async function getStaticPaths(){const posts=await getPosts();return [...new Set(posts.flatMap(p=>p.data.tags))].map(tag=>({params:{tag},props:{tag,posts:posts.filter(p=>p.data.tags.includes(tag))}}))}const {tag,posts}=Astro.props;
---
<BaseLayout title={`#${tag}｜边界之外`}><main class="listing-page"><p class="eyebrow">TAG</p><h1>#{tag}</h1><div class="post-list">{posts.map((post:any)=><PostCard post={post}/>)}</div></main></BaseLayout>
