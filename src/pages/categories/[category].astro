---
import BaseLayout from "../../layouts/BaseLayout.astro";import PostCard from "../../components/PostCard.astro";import {getPosts} from "../../lib/posts";export async function getStaticPaths(){const posts=await getPosts();return [...new Set(posts.map(p=>p.data.category))].map(category=>({params:{category},props:{category,posts:posts.filter(p=>p.data.category===category)}}))}const {category,posts}=Astro.props;
---
<BaseLayout title={`${category}｜边界之外`}><main class="listing-page"><p class="eyebrow">CATEGORY</p><h1>{category}</h1><div class="post-list">{posts.map((post:any)=><PostCard post={post}/>)}</div></main></BaseLayout>
