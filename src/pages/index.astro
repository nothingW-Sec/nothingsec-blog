---
import BaseLayout from "../layouts/BaseLayout.astro";import PostCard from "../components/PostCard.astro";import Sidebar from "../components/Sidebar.astro";import {getPosts} from "../lib/posts";const posts=await getPosts();const featuredPosts=posts.filter(post=>post.data.featured).slice(0,3);
---
<BaseLayout><main><section class="hero"><div class="hero-pattern"></div><div class="hero-copy"><p class="hero-kicker">SECURITY RESEARCH &amp; FIELD NOTES</p><h1>边界之外</h1><p>探索技术边界，记录每一次思考与突破</p><a href="/posts/">开始阅读 ↓</a></div></section><div class="content-shell home-layout"><div class="home-main">{featuredPosts.length>0&&<section class="featured-posts" aria-labelledby="featured-title"><p class="eyebrow">FEATURED</p><h2 id="featured-title">精选文章</h2><div class="post-stream">{featuredPosts.map(post=><PostCard post={post}/>)}</div></section>}<section class="post-stream" aria-label="全部文章">{posts.map(post=><PostCard post={post}/>)}</section></div><Sidebar/></div></main></BaseLayout>
