---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeContent from "../components/HomeContent.astro";
import { getPosts } from "../lib/posts";
import { getHomePageCount, getHomePagePosts } from "../lib/homePagination";

const allPosts = await getPosts();
const totalPages = getHomePageCount(allPosts.length);
const posts = getHomePagePosts(allPosts, 1);
const featuredPosts = allPosts.filter((post) => post.data.featured).slice(0, 3);
---
<BaseLayout>
  <HomeContent posts={posts} featuredPosts={featuredPosts} currentPage={1} totalPages={totalPages} />
</BaseLayout>
