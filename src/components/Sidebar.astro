---
import { getPosts,formatDate,postUrl } from "../lib/posts"; const {headings=[]}=Astro.props; const posts=await getPosts(); const categories=[...new Set(posts.map(p=>p.data.category))];const tags=[...new Set(posts.flatMap(p=>p.data.tags))];
---
<aside class="sidebar"><section class="side-card profile-card"><div class="avatar"><img src="/avatar.webp" alt="边界突破头像" width="512" height="512" loading="eager" decoding="async"/></div><h3>边界突破</h3><p>网络安全学习者<br/>记录实践，也记录思考。</p><div class="stats"><span><b>{posts.length}</b>文章</span><span><b>{categories.length}</b>分类</span><span><b>{tags.length}</b>标签</span></div><a class="follow-button" href="/about/">了解更多</a></section>{headings.length>0&&<section class="side-card toc-card"><h3>目录</h3>{headings.filter((h:any)=>h.depth===2||h.depth===3).map((h:any)=><a class={`level-${h.depth}`} href={`#${h.slug}`}>{h.text}</a>)}</section>}<section class="side-card"><h3>最新文章</h3><div class="side-posts">{posts.slice(0,4).map(p=><a href={postUrl(p.id)}><b>{p.data.title}</b><span>{formatDate(p.data.publishDate)}</span></a>)}</div></section><section class="side-card"><h3>分类</h3><div class="side-list">{categories.map(c=><a href={`/categories/${encodeURIComponent(c)}/`}><span>{c}</span><b>{posts.filter(p=>p.data.category===c).length}</b></a>)}</div></section><section class="side-card"><h3>标签</h3><div class="side-tags">{tags.map(t=><a href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>)}</div></section></aside>
