<div class="reading-tools"><button class="reading-toggle" aria-label="切换阅读模式">阅读</button><button class="back-top" aria-label="返回顶部" hidden>↑</button></div><script>const reading=document.querySelector<HTMLButtonElement>('.reading-toggle'),top=document.querySelector<HTMLButtonElement>('.back-top');reading?.addEventListener('click',()=>{document.body.classList.toggle('reading-mode');reading.textContent=document.body.classList.contains('reading-mode')?'退出':'阅读'});addEventListener('scroll',()=>{if(top)top.hidden=scrollY<=500},{passive:true});top?.addEventListener('click',()=>scrollTo({top:0,behavior:'smooth'}));document.querySelectorAll<HTMLElement>('.prose pre').forEach(pre=>{const b=document.createElement('button');b.className='copy-code';b.textContent='复制';b.addEventListener('click',async()=>{await navigator.clipboard.writeText(pre.querySelector('code')?.textContent??'');b.textContent='已复制 ✓';setTimeout(()=>b.textContent='复制',1500)});pre.append(b)});</script>
