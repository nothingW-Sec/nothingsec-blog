---
import type { Post } from "../lib/posts"; import { coverClass,formatDate } from "../lib/posts";
const {post}=Astro.props as {post:Post}; const d=post.data;
---
<article class={`post-card cover-${coverClass(d.category)}`}><a class="post-cover" href={`/posts/${post.id}/`} aria-label={d.title}>{d.cover&&<img src={d.cover} alt="" loading="lazy" decoding="async"/>}<span>{d.category}</span></a><div class="post-info"><div class="post-meta"><span>📅 {formatDate(d.publishDate)}</span>{d.category&&<a href={`/categories/${encodeURIComponent(d.category)}/`}>📁 {d.category}</a>}{d.type&&<span>📄 {d.type}</span>}{d.difficulty&&<span>◈ {d.difficulty}</span>}</div><h2><a href={`/posts/${post.id}/`}>{d.title}</a></h2><p>{d.description}</p><div class="tags">{d.tags.slice(0,3).map(tag=><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div></div></article>
