---
import type { Post } from "../lib/posts"; import { coverClass,formatDate } from "../lib/posts";
const {post}=Astro.props as {post:Post}; const d=post.data;
---
<article class={`post-card cover-${coverClass(d.category)}`}><a class="post-cover" href={`/posts/${post.id}/`} aria-label={d.title}><span>{d.category}</span></a><div class="post-info"><div class="post-meta"><span>📅 {formatDate(d.publishDate)}</span><a href={`/categories/${encodeURIComponent(d.category)}/`}>📁 {d.category}</a></div><h2><a href={`/posts/${post.id}/`}>{d.title}</a></h2><p>{d.description}</p><div class="tags">{d.tags.slice(0,3).map(tag=><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div></div></article>
